# Neon Database Configuration (server-only, NEVER prefix with VITE_)
# Get these values from your Neon dashboard: https://console.neon.tech/
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Admin API Key (server-only, generate a strong random string)
ADMIN_API_KEY=your-strong-random-api-key-here

# JWT Secret (server-only, generate a strong random string)
JWT_SECRET=your-jwt-secret-key

# Encryption Key (server-only)
ENCRYPTION_KEY=your-encryption-key

# Application Configuration
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://linkmeu.com,https://www.linkmeu.com

# Frontend-only variables (safe to expose to browser)
VITE_APP_NAME=LinkMeU
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=10000
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=false
VITE_MAX_FILE_SIZE=5242880
