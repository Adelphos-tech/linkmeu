{
  "name": "linkmeu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.cjs",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "db:setup": "node scripts/db-setup.js",
    "db:migrate": "node db/scripts/run-migrations.cjs",
    "db:status": "node scripts/db-status.js",
    "test:production": "node test-production.js",
    "test:full": "node test-production.js",
    "test:reports": "node create-excel-report.js",
    "test:capacity": "node capacity-test-suite.js",
    "test:excel": "node generate-excel-report.js",
    "test:capacity:full": "npm run test:capacity && npm run test:excel"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.294.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^11.0.0",
    "exceljs": "^4.4.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.32",
    "puppeteer": "^24.33.0",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4"
